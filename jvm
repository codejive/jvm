DEFAULT_DISTRO=temurin
DEFAULT_VERSION=25

LC_ALL=C
export LC_ALL
VERSION=0.2.1
BASE=https://getjvm.dev/index
WORK= STAGE= CURRENT=
PROJECT_CONFIG_READ= GLOBAL_CONFIG_READ=

# Shared awk helpers, prepended to every awk program that uses them.
# os, arch (and bad, for normal) are program variables set by the caller.
AWK_LIB='
function to_major(v) {sub(/^1\./,"",v); sub(/[^0-9].*$/,"",v); return v}
function compare(a,b) {return length(a)!=length(b) ? (length(a)>length(b) ? 1 : -1) : (("x" a)>("x" b) ? 1 : (("x" a)<("x" b) ? -1 : 0))}
# Installation ID: version-distro, prefixed with the Java major when the version does not start with it.
function make_id(version, distro, jmajor,   id, leading) {
    id=version "-" distro; leading=id; sub(/[^0-9].*$/,"",leading)
    return leading==jmajor ? id : jmajor "-" id
}
# Index/manifest record usable on this host. Columns are the index TSV columns.
function eligible() {
    return ($1=="ga" || $1=="ea") && $2==os && $3==arch && $4=="jdk" &&
        ($10=="tar.gz" || $10=="zip") && (os=="linux-musl" || $15 !~ /(^\[|,)musl(,|\]$)/)
}
# Collapse "." and ".." components; escaping the root returns "!" and sets bad.
function normal(p,   a,n,i,j,out,parts) {
    if (os=="windows") p=tolower(p)
    n=split(p,a,"/"); j=0
    for (i=1;i<=n;i++) {
        if (a[i]=="" || a[i]==".") continue
        if (a[i]=="..") {if (!j) {bad=1; return "!"}; j--}
        else parts[++j]=a[i]
    }
    out=""; for (i=1;i<=j;i++) out=out (i==1 ? "" : "/") parts[i]
    return out
}
# Tab-aligned tables: set every cell, then print rows.
function cell_set(r, c, text) {cells[r,c]=text; if (length(text)>widths[c]) widths[c]=length(text)}
function row_print(r, columns,   c, tabs, t) {
    for (c=1; c<=columns; c++) {
        printf "%s", cells[r,c]
        if (c<columns) {
            tabs=int(widths[c]/8)+1; if (tabs>4) tabs=4
            tabs-=int(length(cells[r,c])/8); if (tabs<1) tabs=1
            for (t=0; t<tabs; t++) printf "\t"
        }
    }
    printf "\n"
}
'

error() { printf 'jvm: %s\n' "$*" >&2; }
help_text() {
    local line
    while IFS= read -r line; do printf '%s\n' "$line"; done <<'EOF'
jvm finds and installs Java Development Kits for this computer.

Usage: jvm <command> [options] [selector]

Commands:
  available, a [-t] [selector]        Show compatible JDKs available to download.
  install, i [-d] [-v] [selector]     Download, verify and install a JDK in user storage.
  uninstall, u <selector>             Remove an installed JDK from user storage.
  list, l [selector]                  Show JDK folders and manifest status, even offline.
  default, d [<major>]                Query the global or Java-major default.
  default, d set [<major>] <selector> Set a persistent JDK default.
  home, h [selector]                  Print an installed JDK home or the stable default path.
  env, e [-f] [selector]              Print Bash exports, including GRAALVM_HOME for GraalVM.
  exec, x <selector> [--] <command> [args...]  Run with a selected JDK or default.
  --help                              Show this help.
  --version                           Show the jvm version.

default set/home/env/exec install automatically when no installed JDK matches.
default queries are offline. After set: one argument is a selector; two are scope and selector.
A scope major is a positive integer without leading zeros.
exec requires a selector; _ uses project java, user java, default, then fallback.
The _ placeholder is exclusive to exec/x and is not a configuration value.
One optional -- immediately after the exec selector is skipped.
The command and all later arguments are forwarded unchanged.

Selectors:
  available/list: major (21), distro (temurin), or distro-major (temurin-21).
  install/uninstall/default/home/env/exec: full ID, major, or distro-major.
  Ranges (except uninstall): 21+, 21..26, temurin-21+; listings show all matches.
  Ranges select the highest major, then its eligible default, then C ID order.
  Install ranges reuse local matches first; remote majors/ranges use configured distro or Temurin.
  Majors use java_version; IDs use version, with a Java-major prefix if needed.
  Bare local majors use an existing per-version default, otherwise match installed JDKs.
  Existing folder names are exact local IDs; ordinary ambiguity needs an exact ID.
  Invalid JDKs or manifests show only ID/status and are skipped by short selectors.

Options:
  -t  available: show release type/features in a final TYPE column.
  -d  install: make the installed JDK the persistent default.
  -v  install: make the installed JDK the default for its Java major.
      Combine -d and -v to select both defaults (major first, then global).
  -f  env: always print the PATH export, even when bin is already on PATH.

Configuration (optional, literal key=value lines):
  ./.jvmrc, then $XDG_CONFIG_HOME/jvm/config (or ~/.config/jvm/config).
  Keys: java=21+ and distro=graalvm-community. No parent-directory lookup.
EOF
    printf '  CLI selector > project java > user java. Install falls back to major %s.\n' "$DEFAULT_VERSION"
    printf '  Omitted home/env selectors and exec _ then use the installed default, falling back to major %s if it is absent.\n' "$DEFAULT_VERSION"
    while IFS= read -r line; do printf '%s\n' "$line"; done <<'EOF'
  Installation distro: explicit selector > project distro > user distro > temurin.
  Configuration does not affect default, available, list, uninstall or help.

Examples:
  jvm install
  jvm i -d temurin-21
  jvm uninstall temurin-21
  jvm default set 21 temurin-21
  jvm home 21
  eval "$(jvm env temurin-21)"
  jvm x _ java -version

Shell setup (once, in your shell profile):
  Unix:
  export JAVA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/jvm/jdks/default"
  export PATH="$JAVA_HOME/bin:$PATH"

  Git Bash / Cygwin / MSYS2:
  export JAVA_HOME="$(cygpath -m "${XDG_DATA_HOME:-$HOME/.local/share}/jvm/jdks/default")"
  export PATH="$(cygpath -u "${JAVA_HOME}")/bin:$PATH"
EOF
}

require_tools() {
    local tool
    for tool in "$@"; do
        command -v "$tool" >/dev/null 2>&1 || { error "required utility missing: $tool"; return 1; }
    done
}

detect_host() {
    local system machine libc info
    info=$(uname -s -m) || return 1
    system=${info%% *} machine=${info#* }
    case "$system" in
        Linux) OS=linux ;;
        Darwin) OS=macosx ;;
        CYGWIN*|MSYS*|MINGW*) OS=windows ;;
        *) error "unsupported operating system: $system ($machine)"; return 1 ;;
    esac
    case "$machine" in
        x86_64|amd64|AMD64) ARCH=x86_64 ;;
        aarch64|arm64|ARM64) ARCH=aarch64 ;;
        i386|i486|i586|i686|x86) ARCH=i686 ;;
        armv7*) error "cannot determine supported ARM ABI from $system/$machine"; return 1 ;;
        ppc64le|s390x|riscv64) ARCH=$machine ;;
        *) error "unsupported architecture: $system/$machine"; return 1 ;;
    esac
    if [ "$OS" = linux ]; then
        libc=$(ldd --version 2>&1)
        case "$libc" in
            *musl*) OS=linux-musl ;;
            *GLIBC*|*'GNU libc'*|*'GNU C Library'*) ;;
            *)
                libc=$(getconf GNU_LIBC_VERSION 2>/dev/null) || libc=
                case "$libc" in
                    glibc\ *) ;;
                    *) error "cannot determine Linux libc for $machine (need ldd or getconf)"; return 1 ;;
                esac ;;
        esac
    fi
}

absolute_path() {
    REPLY=
    case "$1" in
        /*) REPLY=$1 ;;
        [a-zA-Z]:[\\/]*)
            [ "$OS" = windows ] && command -v cygpath >/dev/null 2>&1 || return 1
            REPLY=$(cygpath -u "$1") ;;
        *) return 1 ;;
    esac
}

# Absolute XDG base directory in REPLY: the variable named by $1 when it holds
# an absolute path, otherwise $HOME/$2.
xdg_base() {
    local name=$1
    absolute_path "${!name:-}" && return 0
    absolute_path "${HOME:-}" || { error "need an absolute HOME or $name"; return 1; }
    REPLY=$REPLY/$2
}

cache_path() {
    xdg_base XDG_CACHE_HOME .cache || return 1
    CACHE=$REPLY/jvm
    umask 077
    mkdir -p "$CACHE" || { error "cannot create cache: $CACHE"; return 1; }
    ENTRY=$CACHE/all-$OS-$ARCH-jdk-latest-v1
    WORK=$(mktemp -d "$CACHE/.discovery.XXXXXXXX") || return 1
    trap installation_cleanup EXIT
    trap 'exit 1' HUP INT TERM
}

# Normalize HTTP status/headers for curl and wget. Redirects are restricted to
# HTTPS (wget must expose --https-only); unsupported conditions become plain GET.
transfer() {
    local validator=$1 value=$2 capabilities result
    local -a options
    STATUS=
    : > "$WORK/headers"
    if command -v curl >/dev/null 2>&1; then
        options=(--silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time "${TRANSFER_TIMEOUT:-45}" --dump-header "$WORK/headers" --output "$WORK/download" --write-out '%{http_code}')
        [ -z "$validator" ] || options+=(--header "$validator: $value")
        STATUS=$(curl "${options[@]}" "$URL" 2> "$WORK/transfer-error") || return 1
    elif command -v wget >/dev/null 2>&1; then
        capabilities=$(wget --help 2>&1)
        case "$capabilities" in *--https-only*) ;; *) printf '%s\n' 'wget lacks --https-only; install a TLS-redirect-safe wget or curl' > "$WORK/transfer-error"; return 1 ;; esac
        options=(--https-only --server-response --timeout=15 --tries=1 -O "$WORK/download")
        case "$capabilities" in *--header*) [ -z "$validator" ] || options+=(--header="$validator: $value") ;; esac
        wget "${options[@]}" "$URL" 2> "$WORK/headers"
        result=$?
        STATUS=$(awk '/^[ \t]*HTTP\// {code=$2} END {print code}' "$WORK/headers")
        [ "$result" -eq 0 ] || [ "$STATUS" = 304 ] || { cp "$WORK/headers" "$WORK/transfer-error"; return 1; }
    else
        printf '%s\n' 'install curl or wget to fetch metadata' > "$WORK/transfer-error"
        return 1
    fi
    [ "$STATUS" = 200 ] || [ "$STATUS" = 304 ]
}

header_value() {
    local value
    value=$(awk -v wanted="$1" '
        /^[ \t]*HTTP\// {value=""}
        {line=$0; sub(/\r$/, "", line); sub(/^[ \t]*/, "", line)
         colon=index(line, ":"); if (tolower(substr(line,1,colon-1))==wanted) {
             value=substr(line,colon+1); sub(/^[ \t]*/, "",value)}}
        END {print value}' "$WORK/headers") || return 1
    case "$value" in *[$'\r\n']*) return 1 ;; esac
    printf '%s\n' "$value"
}

load_cache() {
    local saved_url
    VALID=0; CHECKED=0; ETAG=; MODIFIED=
    [ -f "$ENTRY" ] || return 0
    # Open one generation once: another process may replace ENTRY at any time.
    {
        IFS= read -r saved_url && IFS= read -r CHECKED &&
        IFS= read -r ETAG && IFS= read -r MODIFIED || return 0
        [ "$saved_url" = "$URL" ] || return 0
        case "$CHECKED" in ''|*[!0-9]*|????????????*) return 0 ;; esac
        CHECKED=$((10#$CHECKED))
        case "$ETAG$MODIFIED" in *[$'\r\n']*) return 0 ;; esac
        cat > "$WORK/cached" || return 1
    } < "$ENTRY" || return 1
    if [ -s "$WORK/cached" ]; then VALID=1; INDEX=$WORK/cached; fi
}

publish_cache() {
    local body=$1 etag=$2 modified=$3
    {
        printf '%s\n%s\n%s\n%s\n' "$URL" "$NOW" "$etag" "$modified" &&
            cat "$body"
    } > "$WORK/entry" || return 1
    mv -f "$WORK/entry" "$ENTRY"
}

metadata() {
    local validator= value= attempt
    URL=$BASE/metadata/all/$OS/$ARCH/jdk-latest.tsv
    load_cache || return 1
    NOW=$(date +%s) || return 1
    case "$NOW" in ''|*[!0-9]*) error 'date utility must support +%s'; return 1 ;; esac
    if [ "$VALID" -eq 1 ] && [ "$NOW" -ge "$CHECKED" ] && [ "$((NOW - CHECKED))" -lt 3600 ]; then return 0; fi
    if [ "$VALID" -eq 1 ]; then
        if [ -n "$ETAG" ]; then validator=If-None-Match; value=$ETAG
        elif [ -n "$MODIFIED" ]; then validator=If-Modified-Since; value=$MODIFIED; fi
    fi
    for attempt in 1 2; do
        if ! transfer "$validator" "$value"; then break; fi
        if [ "$STATUS" = 304 ]; then
            if [ "$VALID" -eq 1 ]; then
                publish_cache "$WORK/cached" "$ETAG" "$MODIFIED" || { error 'cannot update metadata cache'; return 1; }
                return 0
            fi
            validator=; value=; continue
        fi
        if [ -s "$WORK/download" ]; then
            publish_cache "$WORK/download" "$(header_value etag)" "$(header_value last-modified)" || { error 'cannot publish metadata cache'; return 1; }
            INDEX=$WORK/download
            return 0
        fi
        break
    done
    [ "$VALID" -eq 0 ] || return 0
    error "cannot obtain metadata for $OS/$ARCH from $URL (HTTP ${STATUS:-unavailable})"
    [ ! -s "$WORK/transfer-error" ] || cat "$WORK/transfer-error" >&2
    return 1
}

is_major() { [[ $1 =~ ^[1-9][0-9]*$ ]]; }

# The one place that interprets selector syntax. Sets SEL_KIND to one of
# empty, major, distro, distro-major, range, id (a full installation ID) or
# invalid, plus SEL_DISTRO, SEL_MAJOR, SEL_MIN and SEL_MAX where they apply.
# Range bounds are decimal strings, compared without shell integer overflow.
classify_selector() {
    SEL_KIND=invalid; SEL_DISTRO=; SEL_MAJOR=; SEL_MIN=; SEL_MAX=
    if [[ $1 =~ ^([a-z][a-z0-9-]*-)?([1-9][0-9]*)\+$ ]]; then
        SEL_KIND=range; SEL_DISTRO=${BASH_REMATCH[1]%-}; SEL_MIN=${BASH_REMATCH[2]}
    elif [[ $1 =~ ^([a-z][a-z0-9-]*-)?([1-9][0-9]*)\.\.([1-9][0-9]*)$ ]]; then
        SEL_DISTRO=${BASH_REMATCH[1]%-}; SEL_MIN=${BASH_REMATCH[2]}; SEL_MAX=${BASH_REMATCH[3]}
        if [ "${#SEL_MIN}" -lt "${#SEL_MAX}" ] ||
            { [ "${#SEL_MIN}" -eq "${#SEL_MAX}" ] && [[ ! $SEL_MIN > $SEL_MAX ]]; }; then
            SEL_KIND=range
        else SEL_DISTRO=; SEL_MIN=; SEL_MAX=; fi
    elif [ -z "$1" ]; then SEL_KIND=empty
    elif is_major "$1"; then SEL_KIND=major; SEL_MAJOR=$1
    elif [[ $1 =~ ^([a-z][a-z0-9-]*)-([1-9][0-9]*)$ ]]; then
        SEL_KIND=distro-major; SEL_DISTRO=${BASH_REMATCH[1]}; SEL_MAJOR=${BASH_REMATCH[2]}
    elif [[ $1 =~ ^[a-z][a-z0-9-]*$ ]]; then SEL_KIND=distro; SEL_DISTRO=$1
    elif safe_id "$1"; then SEL_KIND=id; fi
}

# Selector for available/list filtering.
parse_selector() {
    [ "${#1}" -le 100 ] || { error 'selector is too long'; return 2; }
    classify_selector "$1"
    [ "$SEL_KIND" != invalid ] && [ "$SEL_KIND" != id ] && return 0
    if [[ $1 =~ ^0[0-9]*$ ]]; then error 'Java major must be positive, without leading zeros'
    else error 'selector must be a major, distro, distro-major, or version range'; fi
    return 2
}

available() {
    local selector=$1 result
    parse_selector "$selector" || return $?
    require_tools uname mktemp awk date cp || return 1
    detect_host && cache_path && metadata || return 1
    # The published TSV is trusted. Read only listing fields and collapse IDs;
    # do not validate unused metadata or compare builds/archive variants.
    awk -F '\t' -v os="$OS" -v arch="$ARCH" -v distro="$SEL_DISTRO" -v major="$SEL_MAJOR" -v lower="$SEL_MIN" -v upper="$SEL_MAX" -v show_type="${show_type:-}" "$AWK_LIB"'
        function add_row(id, distribution, version, jvm, release, features) {
            rows++
            sub(/^\[/,"",features); sub(/\]$/,"",features)
            cell_set(rows,1,id); cell_set(rows,2,distribution); cell_set(rows,3,version); cell_set(rows,4,jvm)
            cell_set(rows,5,(release=="ea" ? "ea" (features!="" ? "," : "") : "") features)
        }
        BEGIN {columns=(show_type ? 5 : 4); add_row("ID", "DISTRIBUTION", "VERSION", "JVM", "", "TYPE")}
        NR==1 {next}
        {sub(/\r$/, "")}
        !eligible() {next}
        distro!="" && $7!=distro {next}
        {
            java_major=to_major($8)
            if (major!="" && java_major!=major) next
            if (lower!="" && (compare(java_major,lower)<0 || (upper!="" && compare(java_major,upper)>0))) next
            id=make_id($9, $7, java_major)
            if (seen[id]++) next
            add_row(id, $7, $8, $5, $1, $15)
            found=1
        }
        END {
            if ((distro!="" || major!="" || lower!="") && !found) exit 1
            for (row=1; row<=rows; row++) row_print(row, columns)
        }
    ' "$INDEX" > "$WORK/results"
    result=$?
    case "$result" in
        0) cat "$WORK/results" ;;
        1) error "No JDK found matching: $selector"; return 1 ;;
        *) error 'cannot read metadata'; return 1 ;;
    esac
}

# Installation and local inventory use a separate, fixed-field data pipeline.
# Rows: ID, distro, version, JVM, OS, arch, status, URL, SHA256, format, size, java_version.
# Status is "." for ordinary metadata rows, otherwise a diagnostic message.
# Remote rows append the original source TSV record after these internal fields.
safe_id() {
    [ "${#1}" -le 180 ] && [[ $1 =~ ^[0-9][a-zA-Z0-9._+-]*-[a-z][a-z0-9-]*$ ]] &&
        [[ $1 != *..* ]] && [[ $1 != *. ]]
}

# Local directory identities need not have been generated by the installer.
local_id() {
    [ "${#1}" -le 180 ] || return 1
    case "$1" in ''|.|..|default|-*|*/*|*\\*|*[$'\t\r\n']*) return 1 ;; esac
    [[ ! $1 =~ ^[0-9]+$ ]]
}

version_major() {
    local version=$1
    case "$version" in 1.*) version=${version#1.} ;; esac
    REPLY=${version%%[^0-9]*}
    [ -n "$REPLY" ]
}

# Java major of an installed JDK in REPLY.
installation_major() {
    read_installation "$JDKS/$1" || return 1
    row_field 12 "$ROW"
    version_major "$REPLY"
}

check_major() {
    [ -z "$2" ] && return 0
    version_major "$1" || { error 'cannot determine Java major without a valid manifest'; return 1; }
    [ "$REPLY" = "$2" ] || { error "selected JDK has Java major $REPLY, expected $2"; return 1; }
}

# Field N (1-based) of the first internal row, preserving empty fields.
# Result in REPLY; no subprocess.
row_field() {
    local rest=${2%%$'\n'*} n=$1
    while [ "$n" -gt 1 ]; do
        case "$rest" in *$'\t'*) rest=${rest#*$'\t'} ;; *) rest= ;; esac
        n=$((n - 1))
    done
    REPLY=${rest%%$'\t'*}
}

# Validate a selector for installed-JDK commands. $2=local also accepts an
# existing directory name; $3=no-range rejects version ranges.
installation_selector() {
    local valid=
    classify_selector "$1"
    case "$SEL_KIND" in
        empty|id|major|distro-major) valid=1 ;;
        range) [ "${3:-}" = no-range ] || valid=1 ;;
    esac
    [ -n "$valid" ] ||
        { [ "${2:-}" = local ] && local_id "$1" && data_path &&
          [ -d "$JDKS/$1" ] && [ ! -L "$JDKS/$1" ]; } || {
            error 'selector must be a full ID, major, or distro-major (version ranges allowed except for uninstall)'; return 2;
        }
    [ "${#1}" -le 180 ] || { error 'selector is too long'; return 2; }
}

data_path() {
    [ -z "${DATA:-}" ] || return 0
    xdg_base XDG_DATA_HOME .local/share || return 1
    DATA=$REPLY/jvm
    JDKS=$DATA/jdks
}

# Common start of every command that touches the host or the JDK inventory.
init_host() {
    [ -z "${HOST_READY:-}" ] || return 0
    require_tools uname awk || return 1
    detect_host && data_path || return 1
    HOST_READY=1
}

# Configuration is literal data. Load a file only when one of its settings is
# needed; validate the whole file once it is consulted.
read_config() {
    local file=$1 line key value java_seen= distro_seen=
    CONFIG_JAVA= CONFIG_DISTRO=
    [ -e "$file" ] || [ -L "$file" ] || return 0
    [ -f "$file" ] && [ -r "$file" ] || { error "cannot read configuration: $file"; return 1; }
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        case "$line" in ''|'#'*) continue ;; esac
        case "$line" in *=*) ;; *) error "invalid configuration line: $file"; return 1 ;; esac
        key=${line%%=*}; value=${line#*=}
        key=${key%"${key##*[![:space:]]}"}
        value=${value#"${value%%[![:space:]]*}"}
        case "$key" in
            java)
                classify_selector "$value"
                [ -z "$java_seen" ] && [ -n "$value" ] &&
                    case "$SEL_KIND" in id|major|distro-major|range) true ;; *) false ;; esac &&
                    [ "${#value}" -le 180 ] || {
                        error "duplicate or invalid java setting: $file"; return 1;
                    }
                java_seen=1; CONFIG_JAVA=$value ;;
            distro)
                [ -z "$distro_seen" ] && [[ $value =~ ^[a-z][a-z0-9-]*$ ]] &&
                    [ "${#value}" -le 180 ] || {
                        error "duplicate or invalid distro setting: $file"; return 1;
                    }
                distro_seen=1; CONFIG_DISTRO=$value ;;
            *) error "unknown configuration key: $key ($file)"; return 1 ;;
        esac
    done < "$file"
}

config_setting() {
    local key=$1
    if [ -z "${PROJECT_CONFIG_READ:-}" ]; then
        read_config ./.jvmrc || return 1
        PROJECT_JAVA=$CONFIG_JAVA; PROJECT_DISTRO=$CONFIG_DISTRO
        PROJECT_CONFIG_READ=1
    fi
    if [ "$key" = java ]; then SETTING=$PROJECT_JAVA; else SETTING=$PROJECT_DISTRO; fi
    [ -z "$SETTING" ] || return 0
    if [ -z "${GLOBAL_CONFIG_READ:-}" ]; then
        xdg_base XDG_CONFIG_HOME .config || return 1
        read_config "$REPLY/jvm/config" || return 1
        GLOBAL_JAVA=$CONFIG_JAVA; GLOBAL_DISTRO=$CONFIG_DISTRO
        GLOBAL_CONFIG_READ=1
    fi
    if [ "$key" = java ]; then SETTING=$GLOBAL_JAVA; else SETTING=$GLOBAL_DISTRO; fi
}

# Configuration applies to installation for install/home/env/exec, never default.
installation_distro() {
    INSTALL_DISTRO=$DEFAULT_DISTRO
    classify_selector "$1"
    if [ "$SEL_KIND" = major ] || { [ "$SEL_KIND" = range ] && [ -z "$SEL_DISTRO" ]; }; then
        config_setting distro || return 1
        INSTALL_DISTRO=${SETTING:-$DEFAULT_DISTRO}
    fi
}

installation_cleanup() {
    if [ -n "${STAGE:-}" ]; then publication_cleanup; rm -rf -- "$STAGE"; fi
    [ -z "${WORK:-}" ] || rm -rf -- "$WORK"
    :
}

# A unique marker identifies only this operation's copy, including a copy that
# mv put inside a concurrently published destination directory.
publication_cleanup() {
    local target=$JDKS/$ID name=${STAGE##*/} marker
    marker=.jvm-publish-$name
    [ ! -L "$target" ] || return 0
    if [ ! -L "$target/$name" ] && [ -f "$target/$name/$marker" ]; then
        [ ! -e "$STAGE/$name" ] && [ ! -L "$STAGE/$name" ] || return 1
        mv "$target/$name" "$STAGE/$name" || return 1
        rm -rf -- "$STAGE/$name" || return 1
    fi
    if [ -f "$target/$marker" ]; then rm -f -- "$target/$marker" || return 1; fi
    return 0
}

jdk_launcher() {
    local home=$1 name=$2 suffix
    if [ "$OS" = windows ]; then
        for suffix in '' .exe .bat .cmd; do
            [ ! -f "$home/bin/$name$suffix" ] || return 0
        done
        return 1
    else
        [ -f "$home/bin/$name" ] && [ -x "$home/bin/$name" ]
    fi
}

jdk_layout() { jdk_launcher "$1" java && jdk_launcher "$1" javac; }

release_platform() {
    local home=$1 arch name
    [ -f "$home/release" ] || return 0
    arch=$(awk -F '=' '$1=="OS_ARCH" {v=substr($0,index($0,"=")+1); gsub(/^"|"$/, "",v); print v}' "$home/release") || return 1
    name=$(awk -F '=' '$1=="OS_NAME" {v=substr($0,index($0,"=")+1); gsub(/^"|"$/, "",v); print v}' "$home/release") || return 1
    case "$arch" in amd64|AMD64) arch=x86_64 ;; arm64|ARM64) arch=aarch64 ;; x86|i386|i486|i586) arch=i686 ;; esac
    [ -z "$arch" ] || [ "$arch" = "$ARCH" ] || { error 'JDK release architecture does not match the host'; return 1; }
    case "$name" in
        '') return 0 ;;
        Linux) case "$OS" in linux|linux-musl) return 0 ;; esac ;;
        Darwin|macOS|Mac\ OS\ X) [ "$OS" != macosx ] || return 0 ;;
        Windows*) [ "$OS" != windows ] || return 0 ;;
    esac
    error 'JDK release operating system does not match the host'
    return 1
}

# Never source a manifest or vendor release file. Ignore appended TSV columns.
# Prints the internal row of every valid manifest among the given files; a
# manifest belongs to the installation directory that contains it.
manifest_rows() {
    awk -F '\t' -v OFS='\t' -v os="$OS" -v arch="$ARCH" "$AWK_LIB"'
        function finish() {if (file!="" && lines==3 && valid && !bad) print result}
        FNR==1 {
            finish(); file=FILENAME; lines=0; valid=0; bad=0; result=""
            n=split(FILENAME,parts,"/"); id=parts[n-1]
            if ($0!="jvm-manifest-v1") bad=1
        }
        {lines=FNR}
        FNR==2 {
            sub(/\r$/, "")
            if (NF<15 || !eligible() || make_id($9,$7,to_major($8))!=id) next
            sha=tolower($14)
            if (length(sha)!=64 || sha ~ /[^0-9a-f]/) next
            valid=1; result=id OFS $7 OFS $9 OFS $5 OFS $2 OFS $3 OFS "." OFS $11 OFS sha OFS $10 OFS $13 OFS $8
        }
        END {finish()}' "$@"
}

# Row of a directory with a valid manifest in ROW (status 1 if invalid).
# local_rows prefetches every manifest into MANIFEST_ROWS with one process.
manifest_row() {
    local directory=$1 id=${1##*/} rows status
    ROW=
    safe_id "$id" || return 1
    [ -d "$directory" ] && [ ! -L "$directory" ] && [ -f "$directory/.jvm-manifest" ] || return 1
    if [ -n "${MANIFEST_PREFETCHED:-}" ]; then rows=$MANIFEST_ROWS
    else
        rows=$(manifest_rows "$directory/.jvm-manifest"); status=$?
        [ "$status" -le 1 ] || { error 'cannot read installed manifest'; return 5; }
    fi
    rows=$'\n'$rows
    case "$rows" in *$'\n'"$id"$'\t'*) ;; *) return 1 ;; esac
    ROW=${rows#*$'\n'"$id"$'\t'}
    ROW=$id$'\t'${ROW%%$'\n'*}
}

# Strict completeness checks remain necessary for installer publication and
# automatic defaults. Explicit local selection only needs working launchers.
read_installation() {
    manifest_row "$1" || return $?
    jdk_layout "$1" || { ROW=; return 1; }
}

# ROW gets the manifest row, or a row holding only the ID and a diagnostic.
local_row() {
    local directory=$1 id=${1##*/} status message='manifest missing'
    ROW=
    [ -d "$directory" ] && [ ! -L "$directory" ] || return 1
    if ! jdk_layout "$directory"; then
        ROW=$id$'\t\t\t\t\t\t'invalid\ JDK$'\t\t\t\t\t'
        return 0
    fi
    if [ -e "$directory/.jvm-manifest" ] || [ -L "$directory/.jvm-manifest" ]; then
        manifest_row "$directory"; status=$?
        [ "$status" -ne 0 ] || return 0
        [ "$status" -le 1 ] || return "$status"
        message='manifest invalid'
    fi
    ROW=$id$'\t\t\t\t\t\t'$message$'\t\t\t\t\t'
}

usable_local_row() {
    local_row "$1" || return $?
    jdk_layout "$1" || { ROW=; return 1; }
}

local_rows() {
    local directory id status parent=$DATA
    local -a files
    local MANIFEST_PREFETCHED= MANIFEST_ROWS=
    # A missing inventory is valid; an unusable existing ancestor is not a miss.
    while [ ! -e "$parent" ] && [ ! -L "$parent" ]; do
        parent=${parent%/*}
        [ -n "$parent" ] || parent=/
    done
    [ -d "$parent" ] && [ -r "$parent" ] && [ -x "$parent" ] || {
        error 'cannot read installed inventory'; return 1;
    }
    for directory in "$DATA" "$JDKS"; do
        if [ -e "$directory" ] || [ -L "$directory" ]; then
            [ -d "$directory" ] && [ -r "$directory" ] && [ -x "$directory" ] || {
                error 'cannot read installed inventory'; return 1;
            }
        fi
    done
    files=()
    for directory in "$JDKS"/* "$JDKS"/.[!.]* "$JDKS"/..?*; do
        id=${directory##*/}
        if local_id "$id" && safe_id "$id" && [ -d "$directory" ] && [ ! -L "$directory" ] &&
            [ -f "$directory/.jvm-manifest" ]; then files[${#files[@]}]=$directory/.jvm-manifest; fi
    done
    if [ "${#files[@]}" -gt 0 ]; then
        MANIFEST_ROWS=$(manifest_rows "${files[@]}"); status=$?
        [ "$status" -le 1 ] || { error 'cannot read installed manifest'; return 1; }
    fi
    MANIFEST_PREFETCHED=1
    for directory in "$JDKS"/* "$JDKS"/.[!.]* "$JDKS"/..?*; do
        id=${directory##*/}
        local_id "$id" || continue
        if [ "${1:-}" = complete ]; then read_installation "$directory"
        else local_row "$directory"; fi
        status=$?
        [ "$status" -le 1 ] || return 1
        [ "$status" -ne 0 ] || printf '%s\n' "$ROW"
    done
    return 0
}

# Defaults are links only; never replace an unrelated file or directory.
default_current() {
    local target parent link=$JDKS/${1:-default}
    CURRENT=
    if [ ! -L "$link" ]; then
        [ ! -e "$link" ] && return 0
        error "default path is not a managed link: $link"; return 1
    fi
    require_tools readlink || return 1
    target=$(readlink "$link") || return 1
    absolute_path "$target" || return 1
    target=$REPLY
    jdks_real || return 1
    parent=$JDKS_REAL
    CURRENT=${target##*/}
    local_id "$CURRENT" && [ "$target" = "$parent/$CURRENT" ] || {
        CURRENT=; error 'default points outside the managed JDK inventory'; return 1;
    }
}

# Physical path of the inventory directory in JDKS_REAL, resolved once.
jdks_real() {
    [ -n "${JDKS_REAL:-}" ] || JDKS_REAL=$(cd "$JDKS" && pwd -P) || { JDKS_REAL=; return 1; }
}

create_default_link() {
    local link=$1 target=$2
    if [ "$OS" = windows ]; then
        require_tools cygpath cmd.exe || return 1
        # Fixed command text on stdin avoids cmd's /c argument quoting rules.
        # Environment expansion is quoted and delayed expansion is disabled.
        local JVM_LINK JVM_TARGET
        JVM_LINK=$(cygpath -w "$link") && JVM_TARGET=$(cygpath -w "$target") || return 1
        export JVM_LINK JVM_TARGET
        printf '@mklink /J "%%JVM_LINK%%" "%%JVM_TARGET%%"\r\n@exit %%errorlevel%%\r\n' |
            MSYS2_ARG_CONV_EXCL='*' cmd.exe /q /d /v:off > /dev/null 2>&1 || return 1
    else
        require_tools ln || return 1
        ln -sn "$target" "$link" || return 1
    fi
    [ -L "$link" ] && [ "$link" -ef "$target" ] && jdk_layout "$link"
}

default_cleanup() {
    local stage=$1 flag=$2 published=$3 destination=$4 link
    if [ "$published" = 0 ] && [ -L "$stage/previous" ] &&
        [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
        mv "$flag" "$stage/previous" "$destination" || {
            error "cannot restore default; recovery link retained at $stage/previous"; return 1;
        }
    fi
    for link in link previous; do
        [ ! -L "$stage/$link" ] || rm -- "$stage/$link" || return 1
    done
    rmdir "$stage" || return 1
}

# Run in a subshell so private cleanup never replaces installation traps.
set_default() (
    local id=$1 initial=${2:-} name=${3:-default} destination=$JDKS/${3:-default} stage target flag= published=0 previous
    require_tools mkdir mktemp mv rm rmdir readlink || return 1
    default_current "$name" || return 1
    if [ -n "$initial" ] && [ -n "$CURRENT" ]; then return 0; fi
    if [ -z "$id" ]; then
        [ -z "$CURRENT" ] || rm -- "$destination" || return 1
        return 0
    fi
    local_id "$id" && usable_local_row "$JDKS/$id" || {
        error "default JDK is unavailable: $id"; return 1;
    }
    [ "$CURRENT" != "$id" ] || return 0
    target=$(cd "$JDKS/$id" && pwd -P) || return 1
    mkdir -p "$DATA/tmp" || return 1
    stage=$(mktemp -d "$DATA/tmp/default.XXXXXXXX") || return 1
    trap 'default_cleanup "$stage" "$flag" "$published" "$destination"' EXIT
    trap 'exit 1' HUP INT TERM
    if [ -n "$initial" ]; then
        # Creation, unlike replacement, cannot overwrite another first installer.
        if create_default_link "$destination" "$target" 2>/dev/null; then
            report_default "$id" "$name"
            return 0
        fi
        default_current "$name" && [ -n "$CURRENT" ] && return 0
        error 'cannot create the default JDK link'; return 1
    fi
    create_default_link "$stage/link" "$target" || { error 'cannot create the default JDK link'; return 1; }
    # GNU/Cygwin/MSYS mv has -T; BSD mv has -h. Both avoid following the
    # destination directory link. Detect the capability, not just the host.
    case "$(mv --help 2>/dev/null)" in
        *--no-target-directory*) flag=-fT ;;
        *) flag=-fh ;;
    esac
    default_current "$name" || return 1
    if [ -n "$CURRENT" ] && usable_local_row "$JDKS/$CURRENT"; then
        previous=$(cd "$JDKS/$CURRENT" && pwd -P) || return 1
        create_default_link "$stage/previous" "$previous" || {
            error 'cannot prepare default recovery link'; return 1;
        }
    fi
    mv "$flag" "$stage/link" "$destination" || { error 'cannot replace the default JDK link'; return 1; }
    published=1
)

initialize_default() {
    local name=${2:-default}
    # Existing unrelated data is left alone, as it was before defaults existed.
    [ ! -e "$JDKS/$name" ] && [ ! -L "$JDKS/$name" ] || return 0
    set_default "$1" initial "$name" || {
        if [ "$name" = default ]; then error 'JDK installed, but default selection failed; run jvm default set <ID>'
        else error "JDK installed, but Java $name default selection failed; run jvm default set $name <ID>"; fi
        return 1;
    }
}

report_default() {
    if [ -n "$1" ]; then
        if [ "${2:-default}" = default ]; then printf 'Default JDK set to: %s\n' "$1"
        else printf 'Java %s default JDK set to: %s\n' "$2" "$1"; fi
    elif [ "${2:-default}" = default ]; then printf 'No JDK currently set as the default\n'
    else printf 'No JDK currently set as the default for version %s\n' "$2"; fi
} >&2

# Resolve a major reference before enumerating installations. Existing invalid
# references are errors, not permission to select another JDK or install one.
resolve_installed() {
    local selector=$1 row status
    if is_major "$selector" &&
        { [ -e "$JDKS/$selector" ] || [ -L "$JDKS/$selector" ]; }; then
        default_current "$selector" || return 1
        read_installation "$JDKS/$CURRENT" && row=$ROW && { row_field 12 "$row"; check_major "$REPLY" "$selector"; } &&
            [ "$JDKS/$selector" -ef "$JDKS/$CURRENT" ] || {
                error "default JDK for version $selector is unavailable"; return 1;
            }
        printf '%s\n' "$row"
        return 0
    fi
    if local_id "$selector"; then
        usable_local_row "$JDKS/$selector"; status=$?
        if [ "$status" -eq 0 ]; then printf '%s\n' "$ROW"; return 0; fi
        [ "$status" -le 1 ] || return 1
        if [ -d "$JDKS/$selector" ] && [ ! -L "$JDKS/$selector" ]; then
            error "JDK has no usable java/javac launchers: $selector"; return 1
        fi
    fi
    row=$(local_rows) || return 1
    classify_selector "$selector"
    if [ "$SEL_KIND" = range ]; then
        row=$(printf '%s\n' "$row" | select_rows "$selector" '' "range ${2:-}") || return $?
        row=$(resolve_range_rows "$row") || return $?
    else
        row=$(printf '%s\n' "$row" | select_rows "$selector" '' "${2:-}") || return $?
    fi
    [ -z "$row" ] || jdk_layout "$JDKS/${row%%$'\t'*}" || {
        error "JDK has no usable java/javac launchers: ${row%%$'\t'*}"; return 1;
    }
    printf '%s\n' "$row"
}

# Input is the complete eligible inventory at the highest matching major.
# Invalid preferences are ignored; failures reading an actual link are errors.
resolve_range_rows() {
    local rows=$1 major link target preferred= parent
    row_field 12 "$rows"
    version_major "$REPLY" || return 1
    major=$REPLY
    link=$JDKS/$major
    if [ -L "$link" ]; then
        require_tools readlink || return 1
        target=$(readlink "$link") || { error 'cannot read range major default'; return 1; }
        absolute_path "$target" && target=$REPLY || target=
        jdks_real || { error 'cannot resolve installed inventory path'; return 1; }
        parent=$JDKS_REAL
        if [ "$target" = "$parent/${target##*/}" ] && [ "$link" -ef "$target" ]; then preferred=${target##*/}; fi
    fi
    printf '%s\n' "$rows" | awk -F '\t' -v preferred="$preferred" '
        NR==1 || ("x" $1)<("x" id) {id=$1; chosen=$0}
        $1==preferred {selected=$0}
        END {if (selected!="") print selected; else print chosen}'
}

default_jdk() {
    local selector=$1 name=${2:-default} rows id version
    init_host && default_current "$name" || return 1
    if [ -z "$selector" ]; then
        if [ -z "$CURRENT" ]; then
            if [ "$name" = default ]; then printf 'No JDK currently set as the default\n'
            else printf 'No JDK currently set as the default for version %s\n' "$name"; fi
        elif usable_local_row "$JDKS/$CURRENT" &&
            { [ "$name" = default ] || { installation_major "$CURRENT" && [ "$REPLY" = "$name" ]; }; }; then printf '%s\n' "$CURRENT"
        else error "default JDK is unavailable: $CURRENT"; return 1; fi
        return 0
    fi
    rows=$(resolve_installed "$selector") || return $?
    id=${rows%%$'\t'*}
    row_field 12 "$rows"
    version=$REPLY
    [ "$name" = default ] || check_major "$version" "$name" || return 1
    set_default "$id" '' "$name" || return 1
    report_default "$id" "$name"
}

# Resolve offline without changing defaults or touching cache/storage directories.
# Keep global and selected per-major references unless physical output is requested.
resolve_home() {
    local selector=$1 original=${2:-$1} rows id
    init_host || return 1
    if [ -n "$selector" ]; then
        rows=$(resolve_installed "$selector") || return $?
        id=${rows%%$'\t'*}
        if [ "${3:-}" != physical ] && is_major "$original" && [ -L "$JDKS/$original" ] &&
            [ "$JDKS/$original" -ef "$JDKS/$id" ]; then
            jdks_real || { error 'cannot resolve default path'; return 1; }
            RESOLVED_HOME=$JDKS_REAL/$original
        else
            jdks_real || { error 'cannot resolve JDK home'; return 1; }
            RESOLVED_HOME=$JDKS_REAL/$id
        fi
    else
        if [ ! -e "$JDKS/default" ] && [ ! -L "$JDKS/default" ]; then
            error 'No JDK currently set as the default'; return 1;
        fi
        default_current 2>/dev/null && [ -n "$CURRENT" ] &&
            usable_local_row "$JDKS/$CURRENT" 2>/dev/null && rows=$ROW &&
            [ "$JDKS/default" -ef "$JDKS/$CURRENT" ] && jdk_layout "$JDKS/default" || {
                error 'default JDK is missing or unusable'; return 1;
            }
        if [ "${3:-}" = physical ]; then
            jdks_real || { error 'cannot resolve JDK home'; return 1; }
            RESOLVED_HOME=$JDKS_REAL/$CURRENT
        else
            jdks_real || { error 'cannot resolve default path'; return 1; }
            RESOLVED_HOME=$JDKS_REAL/default
        fi
    fi
    row_field 4 "$rows"
    RESOLVED_IMPL=$REPLY
    # Both interfaces promise single-line output. Never emit broken shell code.
    case "$RESOLVED_HOME" in ''|*[$'\r\n']*) error 'JDK home must be a nonempty single-line path'; return 1 ;; esac
}

# Literal single-quoted Bash word, escaping embedded apostrophes without eval.
shell_quote() {
    REPLY=${1//\'/\'\\\'\'}
    REPLY="'$REPLY'"
}

# Shared path preparation for emitted exports and direct child environments.
jdk_environment() {
    ENV_JAVA_HOME=$RESOLVED_HOME
    ENV_PATH_HOME=$RESOLVED_HOME
    if [ "$OS" = windows ]; then
        require_tools cygpath || return 1
        ENV_JAVA_HOME=$(cygpath -m "$RESOLVED_HOME") &&
            ENV_PATH_HOME=$(cygpath -u "$RESOLVED_HOME") || { error 'cannot convert JDK home path'; return 1; }
        case "$ENV_JAVA_HOME" in [a-zA-Z]:/*|//*) ;; *) error 'cannot convert native JDK home path'; return 1 ;; esac
        case "$ENV_PATH_HOME" in /*) ;; *) error 'cannot convert Bash JDK home path'; return 1 ;; esac
    fi
    case "$ENV_JAVA_HOME$ENV_PATH_HOME" in *[$'\r\n']*) error 'JDK home must be a single-line path'; return 1 ;; esac
}

home_environment() {
    local command=$1 selector=$2 quoted_java quoted_bin usage script_path argument
    resolve_home "$selector" "${3:-$selector}" || return $?
    if [ "$command" = home ]; then printf '%s\n' "$RESOLVED_HOME"; return 0; fi
    jdk_environment || return 1
    shell_quote "$ENV_JAVA_HOME"; quoted_java=$REPLY
    shell_quote "$ENV_PATH_HOME/bin"; quoted_bin=$REPLY
    script_path=$0
    case "$script_path" in *[$'\r\n']*) error 'script path must be a single-line path'; return 1 ;; esac
    shell_quote "$script_path"; usage=$REPLY
    for argument in "${original_arguments[@]}"; do
        case "$argument" in *[!a-zA-Z0-9.+_-]*) shell_quote "$argument"; argument=$REPLY ;; esac
        usage="$usage $argument"
    done
    printf '# Use: eval "$(%s)"\nexport JAVA_HOME=%s\n' "$usage" "$quoted_java"
    if [ "$RESOLVED_IMPL" = graalvm ]; then
        printf 'export GRAALVM_HOME=%s\n' "$quoted_java"
    fi
    if [ -z "$force_env" ]; then
        case ":${PATH:-}:" in *":$ENV_PATH_HOME/bin:"*) return 0 ;; esac
    fi
    printf 'export PATH=%s:"$PATH"\n' "$quoted_bin"
}

run_jdk() {
    local selector=$1
    shift
    resolve_home "$selector" "$selector" physical && jdk_environment || return $?
    # Successful exec bypasses EXIT traps. Remove installation temporaries now,
    # then restore the caller's umask before replacing this process.
    if [ -n "$STAGE" ]; then
        publication_cleanup && rm -rf -- "$STAGE" || {
            error 'cannot clean installation staging before execution'; return 1;
        }
        STAGE=
    fi
    if [ -n "$WORK" ]; then
        rm -rf -- "$WORK" || { error 'cannot clean metadata staging before execution'; return 1; }
        WORK=
    fi
    trap - EXIT HUP INT TERM
    umask "$execution_umask"
    export JAVA_HOME=$ENV_JAVA_HOME
    export PATH="$ENV_PATH_HOME/bin${PATH+:$PATH}"
    exec -- "$@"
}

replacement_default() {
    local removed=$1 version=$2 rows
    rows=$(local_rows complete) || return 1
    printf '%s\n' "$rows" | awk -F '\t' -v removed="$removed" -v version="$version" "$AWK_LIB"'
        BEGIN {old=to_major(version)+0}
        NF && $1!=removed {
            if (first=="") first=$1
            m=to_major($12)+0
            if (m==old && same=="") same=$1
            if (m>old && (higher=="" || m<high)) {higher=$1; high=m}
            if (m<old && (lower=="" || m>low)) {lower=$1; low=m}
        }
        END {if (version=="") print first; else if (same!="") print same; else if (higher!="") print higher; else if (lower!="") print lower}'
}

remote_rows() {
    awk -F '\t' -v OFS='\t' -v os="$OS" -v arch="$ARCH" "$AWK_LIB"'
        NR==1 {next} {source=$0; sub(/\r$/, "")}
        !eligible() {next}
        {print make_id($9,$7,to_major($8)),$7,$9,$5,$2,$3,".",$11,tolower($14),$10,$13,$8,source}
    ' "$INDEX"
}

# Match exact IDs before interpreting short selectors. The index already supplies
# latest releases; ranges rank majors and break ID ties by C string order.
# Only installation supplies a default distro ($2) for bare majors/ranges.
# $3 holds space-separated flags: all (list every match, including every
# distro or all IDs of a range), range (candidates of the highest range major
# instead of an ambiguity failure), probe (silent miss, status 4) and no-range.
select_rows() {
    local rows result lower= upper= major= distro= reject= listing= probe=
    case " ${3:-} " in
        *" all "*) listing=all ;;
        *" range "*) listing=range ;;
    esac
    case " ${3:-} " in *" probe "*) probe=1 ;; esac
    classify_selector "$1"
    case "$SEL_KIND" in
        range)
            case " ${3:-} " in
                *" no-range "*) reject=1 ;;
                *) lower=$SEL_MIN; upper=$SEL_MAX; distro=${SEL_DISTRO:-${2:-}} ;;
            esac ;;
        major) major=$SEL_MAJOR; distro=${2:-} ;;
        distro-major) major=$SEL_MAJOR; distro=$SEL_DISTRO ;;
        distro) if [ -n "$listing" ]; then distro=$SEL_DISTRO; else reject=1; fi ;;
        empty) [ -n "$listing" ] || reject=1 ;;
        *) reject=1 ;;
    esac
    rows=$(awk -F '\t' -v selector="$1" -v listing="$listing" -v probe="$probe" -v lower="$lower" -v upper="$upper" -v major="$major" -v distro="$distro" -v reject="$reject" "$AWK_LIB"'
        {rows[NR]=$0; ids[NR]=$1; versions[NR]=$12; distros[NR]=$2; if ($1==selector) exact=1}
        END {
            if (!exact && reject) {if (!probe) print "No JDK found matching: " selector > "/dev/stderr"; exit 4}
            for (i=1;i<=NR;i++) {
                if (exact) {if (ids[i]!=selector) continue}
                else {
                    if (versions[i]=="" && !(listing && selector=="")) continue
                    m=to_major(versions[i])
                    if ((major!="" && m!=major) || (distro!="" && distros[i]!=distro)) continue
                    if (lower!="") {
                        if (compare(m,lower)<0 || (upper!="" && compare(m,upper)>0)) continue
                        if (listing!="all") {
                            if (highest!="" && compare(m,highest)<0) continue
                            if (highest=="" || compare(m,highest)>0) {count=0; highest=m; choice=""}
                            if (choice=="" || ("x" ids[i])<("x" choice)) choice=ids[i]
                        }
                    }
                }
                count++; matches[count]=i
                if (!seen[ids[i]]++) distinct++
            }
            if (!count && !(listing && selector=="")) {if (!probe) print "No JDK found matching: " selector > "/dev/stderr"; exit 4}
            if (!listing && distinct>1 && (exact || lower=="")) {
                for (j=1;j<=count;j++) {
                    i=matches[j]; if (!displayed[ids[i]]++) print rows[i]
                }
                exit 3
            }
            for (j=1;j<=count;j++) {
                i=matches[j]
                if (!exact && lower!="" && !listing && ids[i]!=choice) continue
                print rows[i]
            }
        }')
    result=$?
    if [ "$result" -eq 3 ]; then
        printf '%s\n' 'Multiple JDKs match, try again using one of the following IDs:' >&2
        printf '%s\n' "$rows" | format_rows >&2
        return 1
    fi
    if [ "$result" -eq 4 ]; then
        [ -z "$probe" ] || return 4
        return 1
    fi
    [ "$result" -eq 0 ] || return "$result"
    [ -z "$rows" ] || printf '%s\n' "$rows"
    return 0
}

list_installed() {
    local selector=${1:-} rows row id version major majors= seen=' '
    init_host || return 1
    { local_id "$selector" && [ -d "$JDKS/$selector" ] && [ ! -L "$JDKS/$selector" ]; } ||
        safe_id "$selector" || parse_selector "$selector" || return $?
    rows=$(local_rows) || return 1
    default_current 2>/dev/null || CURRENT=
    if [ -z "$rows" ]; then
        printf '%s\n' "No JDKs are installed. Use 'install' to install one"
        return 0
    fi
    while IFS= read -r row; do
        row_field 12 "$row"
        version_major "$REPLY" || continue
        major=$REPLY
        case "$seen" in *" $major "*) continue ;; esac
        seen="$seen$major "
        if default_current "$major" 2>/dev/null && [ -n "$CURRENT" ] &&
            installation_major "$CURRENT" 2>/dev/null && [ "$REPLY" = "$major" ]; then
            majors="$majors $major:$CURRENT"
        fi
    done <<< "$rows"
    default_current 2>/dev/null || CURRENT=
    MAJOR_DEFAULTS=$majors
    rows=$(printf '%s\n' "$rows" | select_rows "$selector" '' all) || return $?
    printf '%s\n' "$rows" | format_rows
}

format_rows() {
    awk -F '\t' -v current="${CURRENT:-}" -v majors="${MAJOR_DEFAULTS:-}" "$AWK_LIB"'
        function add(a,b,c,d,status,   i,mark) {
            n++; cell_set(n,1,a); cell_set(n,2,b); cell_set(n,3,c); cell_set(n,4,d)
            if (status!="" && status!=".") problem[n]=status
            mark=(n==1 ? "DEFAULT" : (a==current ? "global" : ""))
            if (n>1) for (i=1;i<=major_count;i++) if (a==major_id[i])
                mark=mark (mark!="" ? "," : "") major_name[i]
            cell_set(n,5,mark)
        }
        BEGIN {major_count=split(majors,parts," "); for (i=1;i<=major_count;i++) {
            split(parts[i],pair,":"); major_name[i]=pair[1]; major_id[i]=pair[2]
        }; add("ID","DISTRIBUTION","VERSION","JVM")}
        NF {add($1,$2,$12,$4,$7)}
        END {for (r=1;r<=n;r++) {
            if (problem[r]!="") {printf "%s\t(%s)\n",cells[r,1],problem[r]; continue}
            row_print(r,5)
        }}'
}

checksum_tool() {
    if command -v sha256sum >/dev/null 2>&1; then HASH=sha256sum
    elif command -v shasum >/dev/null 2>&1; then HASH=shasum
    elif command -v openssl >/dev/null 2>&1; then HASH=openssl
    else error 'install sha256sum, shasum, or openssl to verify SHA-256'; return 1; fi
}

verify_download() {
    local digest bytes
    case "$HASH" in
        sha256sum) digest=$(sha256sum "$WORK/download") ;;
        shasum) digest=$(shasum -a 256 "$WORK/download") ;;
        openssl) digest=$(openssl dgst -sha256 "$WORK/download") ;;
    esac || { error 'SHA-256 verifier failed'; return 1; }
    digest=$(printf '%s\n' "$digest" | awk '{if (length($1)==64) print tolower($1); else print tolower($NF)}')
    [ "$digest" = "$SHA" ] || { error 'SHA-256 checksum mismatch'; return 1; }
    if [ -n "$SIZE" ]; then
        bytes=$(wc -c < "$WORK/download") || return 1
        [ "$bytes" -eq "$SIZE" ] || { error 'download size mismatch'; return 1; }
    fi
}

# Read and validate the entire directory before extraction. We accept ordinary
# files, directories, symlinks and hardlinks only. The conservative pathname
# alphabet avoids ambiguous/escaped utility listings and unzip pattern matching.
archive_inventory() {
    if [ "$FORMAT" = tar.gz ]; then
        require_tools tar || return 1
        tar -tzf "$WORK/download" > "$STAGE/names" &&
            tar -tvzf "$WORK/download" > "$STAGE/verbose" || { error 'cannot inspect tar.gz archive'; return 1; }
        awk '
            {type=substr($1,1,1)
             if (type=="l") {if ($(NF-1)!="->") exit 1; name=$(NF-2); target=$NF}
             else if (type=="h") {if ($(NF-2)!="link" || $(NF-1)!="to") exit 1; name=$(NF-3); target=$NF}
             else {name=$NF; target=""}
             if (type!="-" && type!="d" && type!="l" && type!="h") exit 1
             print type "\t" name "\t" target}
        ' "$STAGE/verbose" > "$STAGE/entries" || { error 'unsupported tar entry listing'; return 1; }
    else
        require_tools unzip || return 1
        unzip -Z -1 "$WORK/download" > "$STAGE/names" &&
            unzip -Z -l "$WORK/download" > "$STAGE/verbose" || { error 'cannot inspect zip archive (need Info-ZIP listing support)'; return 1; }
        awk '
            $1 ~ /^[-dl?][rwxstST?-]/ {
                type=substr($1,1,1); name=$NF
                if (type=="?") type="-"
                if (name ~ /\/$/) type="d"
                print type "\t" name "\t"
            }' "$STAGE/verbose" > "$STAGE/entries" || return 1
    fi
    # Pair the two listings to detect whitespace, quoting, truncation and entries
    # that a verbose-list parser did not understand. Duplicate entries are unsafe.
    awk -F '\t' -v os="$OS" '
        function path(p) {return p ~ /^[a-zA-Z0-9._+@%\/=-]+$/ && p !~ /^\// && p !~ /(^|\/)\.\.($|\/)/}
        NR==FNR {names[++n]=$0; next}
        {i++; if ($2!=names[i] || !path($2)) exit 1}
        END {if (i!=n || n==0) exit 1}
    ' "$STAGE/names" "$STAGE/entries" || { error 'unsafe or unsupported archive paths'; return 1; }
    if [ "$FORMAT" = zip ]; then
        local type name target
        : > "$STAGE/zip-entries"
        while IFS=$'\t' read -r type name target; do
            if [ "$type" = l ]; then
                target=$(unzip -p "$WORK/download" "$name") || return 1
                [ "${#target}" -le 4096 ] && [[ $target != *[$'\r\n\t']* ]] || return 1
            else target=; fi
            printf '%s\t%s\t%s\n' "$type" "$name" "$target" >> "$STAGE/zip-entries" || return 1
        done < "$STAGE/entries"
        mv "$STAGE/zip-entries" "$STAGE/entries" || return 1
    fi
    awk -F '\t' -v os="$OS" "$AWK_LIB"'
        function ancestors(p, a,n,i,prefix) {
            n=split(p,a,"/"); prefix=""
            for (i=1;i<n;i++) {
                prefix=normal(prefix (i==1 ? "" : "/") a[i])
                if (prefix in types && types[prefix]!="d") bad=1
            }
        }
        {
            name=normal($2)
            type=$1
            if (name=="" && type=="d") next
            if (name=="" || name in types) bad=1
            types[name]=type
            if (os=="windows") {
                folded=tolower(name); if (folded in windows_names) bad=1
                windows_names[folded]=1
                n=split(folded,components,"/")
                for (c=1;c<=n;c++) if (components[c] ~ /\.$/ || components[c] ~ /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\.|$)/) bad=1
            }
            if (type=="l" || type=="h") {
                if ($3 !~ /^[a-zA-Z0-9._+@%\/=-]+$/ || $3 ~ /^\//) {bad=1; next}
                parent=name; sub(/[^\/]+$/,"",parent)
                raw_targets[name]=(type=="l" ? parent : "") $3
                if (os=="windows") raw_targets[name]=tolower(raw_targets[name])
                targets[name]=normal(raw_targets[name])
            }
        }
        END {
            for (name in types) ancestors(name)
            for (name in targets) {
                ancestors(raw_targets[name])
                target=targets[name]; ancestors(target)
                if (types[name]=="h" && types[target]!="-") bad=1
                # Internal link chains are allowed; cycles and dangling links fail.
                steps=0
                while (types[target]=="l") {
                    target=targets[target]; if (++steps>NR) {bad=1; break}
                }
                if (!(target in types)) {
                    implicit=0; for (p in types) if (index(p,target "/")==1) implicit=1
                    if (!implicit && target!="") bad=1
                }
            }
            if (bad) exit 1
        }
    ' "$STAGE/entries" || { error 'unsafe archive paths or links'; return 1; }
}

# Removing archive wrappers must not turn an internal archive link into a link
# outside the installed home. Hardlinks are already regular file content here.
home_links() {
    awk -F '\t' -v home="${JDK_HOME#"$STAGE/unpacked"}" -v os="$OS" "$AWK_LIB"'
        BEGIN {home=normal(home)}
        $1=="l" {
            name=normal($2)
            if (home!="" && index(name,home "/")!=1) next
            parent=name; sub(/[^\/]+$/,"",parent)
            target=normal(parent $3)
            if (target=="!" || (home!="" && target!=home && index(target,home "/")!=1)) exit 1
        }
    ' "$STAGE/entries" || { error 'archive link escapes the normalized JDK home'; return 1; }
}

extract_jdk() {
    local bin candidate found=0
    require_tools find || return 1
    archive_inventory || return 1
    mkdir "$STAGE/unpacked" || return 1
    if [ "$FORMAT" = tar.gz ]; then
        (umask 022; tar -xzf "$WORK/download" -C "$STAGE/unpacked") || { error 'tar.gz extraction failed'; return 1; }
    else
        (umask 022; unzip -q "$WORK/download" -d "$STAGE/unpacked") || { error 'zip extraction failed'; return 1; }
    fi
    # Search wrappers and macOS bundles without following directory symlinks.
    find "$STAGE/unpacked" -name bin -print > "$STAGE/bin-dirs" || return 1
    while IFS= read -r bin; do
        candidate=${bin%/bin}
        if jdk_layout "$candidate"; then JDK_HOME=$candidate; found=$((found+1)); fi
    done < "$STAGE/bin-dirs"
    [ "$found" -eq 1 ] || { error 'archive must contain exactly one JDK with bin/java and bin/javac (Windows also .exe, .bat, .cmd)'; return 1; }
    [ ! -e "$JDK_HOME/.jvm-manifest" ] && [ ! -L "$JDK_HOME/.jvm-manifest" ] || {
        error 'archive contains reserved .jvm-manifest'; return 1;
    }
    home_links && release_platform "$JDK_HOME"
}

install_default() {
    local major= options=" ${1:-} "
    installation_major "$INSTALLED_ID" && major=$REPLY
    case "$options" in
        *' -v '*)
            [ -n "$major" ] || { error 'cannot select a per-major default: selected JDK has no valid Java major'; return 1; }
            set_default "$INSTALLED_ID" '' "$major" || return 1
            report_default "$INSTALLED_ID" "$major" ;;
        *) [ -z "$major" ] || initialize_default "$INSTALLED_ID" "$major" || return 1 ;;
    esac
    if [[ $options = *' -d '* ]]; then
        set_default "$INSTALLED_ID" || return 1
        report_default "$INSTALLED_ID"
    else initialize_default "$INSTALLED_ID" || return 1; fi
}

# Restore references already changed before a failed removal.
restore_removal_defaults() {
    local id=$1 references=$2 entry name
    for entry in $references; do
        name=${entry%%:*}
        if default_current "$name" && [ "$CURRENT" = "${entry#*:}" ]; then
            set_default "$id" '' "$name" || error "couldn't restore default $name to $id"
        fi
    done
}

uninstall_jdk() {
    local selector=$1 rows id removal hint= replacement= version major link name
    local references= changed= global_before= candidates
    init_host && require_tools mktemp || return 1
    rows=$(local_rows) || return 1
    rows=$(printf '%s\n' "$rows" | select_rows "$selector" '' no-range) || return $?
    id=${rows%%$'\t'*}
    local_id "$id" || { error 'unsafe installation ID'; return 1; }
    row_field 12 "$rows"
    version=$REPLY
    umask 077
    mkdir -p "$DATA/tmp" || return 1
    removal=$(mktemp -d "$DATA/tmp/remove-$id.XXXXXXXX") || return 1
    if [ -L "$JDKS/default" ]; then
        require_tools readlink || { rmdir "$removal"; return 1; }
        default_current 2>/dev/null || CURRENT=
    else CURRENT=; fi
    global_before=$CURRENT
    # Reference names remain known even if their target lost its manifest.
    for link in "$JDKS"/[0-9]*; do
        name=${link##*/}
        is_major "$name" && [ -L "$link" ] || continue
        require_tools readlink || { rmdir "$removal"; return 1; }
        if default_current "$name" 2>/dev/null && [ "$CURRENT" = "$id" ]; then
            references="$references $name"
        fi
    done
    if [ "$global_before" = "$id" ]; then
        replacement=$(replacement_default "$id" "$version") || { rmdir "$removal"; return 1; }
        set_default "$replacement" || { rmdir "$removal"; return 1; }
        changed="default:$replacement"
    fi
    if [ -n "$references" ]; then
        candidates=$(local_rows complete) || {
            restore_removal_defaults "$id" "$changed"; rmdir "$removal"; return 1;
        }
        for major in $references; do
            replacement=$(printf '%s\n' "$candidates" | awk -F '\t' -v removed="$id" -v major="$major" "$AWK_LIB"'
                $1!=removed && to_major($12)==major {print $1; exit}')
            if ! set_default "$replacement" '' "$major"; then
                restore_removal_defaults "$id" "$changed"
                rmdir "$removal" 2>/dev/null || :
                return 1
            fi
            changed="$changed $major:$replacement"
        done
    fi
    # Keep the reserved directory: ordinary mv places the home inside it.
    # Never recursively remove anything beneath jdks, even on move failure.
    if ! mv "$JDKS/$id" "$removal/" 2>/dev/null; then
        restore_removal_defaults "$id" "$changed"
        rmdir "$removal" 2>/dev/null || :
        [ "$OS" != windows ] || hint=' (it might be in use)'
        error "couldn't uninstall $id$hint"
        return 1
    fi
    rm -rf -- "$removal" || { error "cannot remove uninstalled JDK staging directory: $removal"; return 1; }
    printf 'Successfully uninstalled %s\n' "$id" >&2
    for link in $changed; do report_default "${link#*:}" "${link%%:*}"; done
    return 0
}

install_jdk() {
    local selector=$1 make_default=${2:-} expected_major=${3:-} rows result preferred multiple existing publish_home publish_marker install_distro=$DEFAULT_DISTRO
    INSTALLED_ID=
    init_host && require_tools mktemp date cp wc || return 1
    umask 077
    # A known exact ID remains usable offline after upstream drops its record.
    if local_id "$selector" && usable_local_row "$JDKS/$selector"; then
        rows=$ROW
        row_field 12 "$rows"
        check_major "$REPLY" "$expected_major" || return 1
        INSTALLED_ID=$selector
        install_default "$make_default" || return 1
        printf 'Already installed %s\n' "$selector" >&2; return 0
    fi
    classify_selector "$selector"
    if [ "$SEL_KIND" = range ]; then
        rows=$(resolve_installed "$selector" probe); result=$?
        case "$result" in
            0) INSTALLED_ID=${rows%%$'\t'*}
               row_field 12 "$rows"
               check_major "$REPLY" "$expected_major" || return 1
               install_default "$make_default" || return 1
               printf 'Already installed %s\n' "$INSTALLED_ID" >&2; return 0 ;;
            4) ;; # Only a genuine local miss permits remote resolution.
            *) return "$result" ;;
        esac
    fi
    # Only an installed directory may use a name that is not a remote selector.
    installation_selector "$selector" || return $?
    if [ "${4:-}" = config ]; then
        installation_distro "$selector" || return 1
        install_distro=$INSTALL_DISTRO
    fi
    cache_path || return 1
    metadata || return 1
    rows=$(remote_rows | select_rows "$selector" "$install_distro"); result=$?
    [ "$result" -eq 0 ] || return "$result"
    row_field 12 "$rows"
    check_major "$REPLY" "$expected_major" || return 1
    preferred=tar.gz; [ "$OS" != windows ] || preferred=zip
    rows=$(printf '%s\n' "$rows" | awk -F '\t' -v preferred="$preferred" '
        {rows[NR]=$0; formats[NR]=$10; if ($10==preferred) found=1}
        END {for (i=1;i<=NR;i++) if (!found || formats[i]==preferred) print rows[i]}') || return 1
    case "$rows" in *$'\n'*) multiple=1 ;; *) multiple= ;; esac
    [ -z "$multiple" ] || { error 'multiple artifact rows remain for the resolved ID and chosen archive format; use a corrected upstream index'; return 1; }
    ID=${rows%%$'\t'*}
    safe_id "$ID" || { error 'unsafe installation ID'; return 1; }
    INSTALLED_ID=$ID
    existing=$JDKS/$ID
    if read_installation "$existing"; then install_default "$make_default" || return 1; printf 'Already installed %s\n' "$ID" >&2; return 0; fi
    [ ! -e "$existing" ] && [ ! -L "$existing" ] || { error "incomplete or incompatible installation already exists: $existing"; return 1; }
    printf 'Installing %s...\n' "$ID" >&2
    row_field 8 "$rows"; URL=$REPLY
    row_field 9 "$rows"; SHA=$REPLY
    row_field 10 "$rows"; FORMAT=$REPLY
    row_field 11 "$rows"; SIZE=$REPLY
    [[ $URL = https://* ]] && [[ $URL != *[$'\r\n\t']* ]] || { error 'artifact URL must use HTTPS'; return 1; }
    [ "${#SHA}" -eq 64 ] && [[ $SHA != *[!a-f0-9]* ]] || { error 'expected SHA-256 is missing or invalid'; return 1; }
    case "$SIZE" in ''|*[!0-9]*|??????????????????*) [ -z "$SIZE" ] || { error 'invalid advertised size'; return 1; } ;; esac
    checksum_tool || return 1
    mkdir -p "$JDKS" "$DATA/tmp" || return 1
    STAGE=$(mktemp -d "$DATA/tmp/jdk-$ID.XXXXXXXX") || return 1
    TRANSFER_TIMEOUT=1800
    if ! transfer '' '' || [ "$STATUS" != 200 ]; then error "artifact transfer failed (HTTP ${STATUS:-unavailable})"; return 1; fi
    verify_download && extract_jdk || return 1
    # The first twelve fields are internal; retain the complete original TSV row.
    printf '%s\n' "$rows" | awk '
        {source=$0; for (i=0;i<12;i++) source=substr(source,index(source,"\t")+1)
         print "jvm-manifest-v1"; print source; print ""}' > "$JDK_HOME/.jvm-manifest" || return 1
    publish_home=$STAGE/${STAGE##*/}
    publish_marker=.jvm-publish-${STAGE##*/}
    mv "$JDK_HOME" "$publish_home" || { error 'cannot prepare installation for publication'; return 1; }
    (set -C; : > "$publish_home/$publish_marker") || { error 'cannot mark staging directory'; return 1; }
    if ! read_installation "$existing"; then
        mv "$publish_home" "$existing" 2> "$WORK/publish-error" || :
    fi
    publication_cleanup || return 1
    if ! read_installation "$existing"; then
        error "cannot publish installation: $ID"
        [ ! -s "$WORK/publish-error" ] || cat "$WORK/publish-error" >&2
        return 1
    fi
    install_default "$make_default" || return 1
    printf 'Successfully installed %s\n' "$ID" >&2
}

# Resolve locally first. Only the selector helper's explicit miss permits install.
ensure_installed() {
    local selector=$1 expected_major=${2:-} rows status
    init_host || return 1
    rows=$(resolve_installed "$selector" probe); status=$?
    case "$status" in
        0) INSTALLED_ID=${rows%%$'\t'*}
           row_field 12 "$rows"
           check_major "$REPLY" "$expected_major" || return 1 ;;
        4) install_jdk "$selector" '' "$expected_major" "${3:-}" || return $? ;;
        *) return 1 ;;
    esac
}

default_usage() {
    error 'usage: jvm default [<major>] | jvm default set [<major>] <selector>'
    return 2
}

parse_default() {
    [ "$#" -gt 0 ] || return 0
    if [ "$1" = set ]; then
        shift
        case "$#" in
            1) selector=$1 ;;
            2) is_major "$1" || { default_usage; return 2; }
               major_option=$1; selector=$2 ;;
            *) default_usage; return 2 ;;
        esac
        [ -n "$selector" ] || { default_usage; return 2; }
    else
        [ "$#" -eq 1 ] && is_major "$1" || { default_usage; return 2; }
        major_option=$1
    fi
}

original_arguments=("$@")
command=${1:-}
case "$command" in
    a) command=available ;; l) command=list ;; i) command=install ;;
    u) command=uninstall ;; d) command=default ;; e) command=env ;; h) command=home ;;
    x) command=exec ;;
esac
case "$command" in
    --help|--version)
        [ "$#" -eq 1 ] || { error "$command takes no arguments"; exit 2; }
        if [ "$command" = --help ]; then help_text; else printf 'jvm %s\n' "$VERSION"; fi
        exit 0 ;;
    available|list|install|uninstall|default|home|env|exec) ;;
    *) error 'usage: jvm <command> [selector]; use jvm --help'; exit 2 ;;
esac
shift
if [ "$#" -eq 1 ] && [ "$1" = --help ]; then help_text; exit 0; fi
selector= option= major_option= force_env= show_type=
if [ "$command" = exec ]; then
    [ "$#" -gt 0 ] && [ -n "$1" ] || {
        error 'usage: jvm exec <selector> [--] <command> [args...]'; exit 2;
    }
    selector=$1
    shift
    if [ "${1:-}" = -- ]; then shift; fi
    [ "$#" -gt 0 ] && [ -n "$1" ] || {
        error 'usage: jvm exec <selector> [--] <command> [args...]'; exit 2;
    }
    [ "$selector" != _ ] || selector=
elif [ "$command" = default ]; then
    parse_default "$@" || exit 2
else
    while [ "$#" -gt 0 ]; do
        argument=$1
        shift
        case "$command:$argument" in
            available:-t)
                [ -z "$show_type" ] || { error 'duplicate flag'; exit 2; }
                show_type=1 ;;
            env:-f)
                [ -z "$force_env" ] || { error 'duplicate flag'; exit 2; }
                force_env=1 ;;
            install:-d|install:-v)
                case " $option " in *" $argument "*) error 'duplicate flag'; exit 2 ;; esac
                option="${option:+$option }$argument" ;;
            *:-*) error "unsupported flag: $argument"; exit 2 ;;
            *)
                [ -n "$argument" ] && [ -z "$selector" ] || { error 'expected one nonempty selector'; exit 2; }
                selector=$argument ;;
        esac
    done
fi
if [ -z "$selector" ]; then
    case "$command" in
        uninstall)
            error "usage: jvm $command <selector>"
            printf 'for more information run: jvm %s --help\n' "$command" >&2
            exit 2 ;;
    esac
fi
case "$command" in
    default) installation_selector "$selector" local || { default_usage; exit 2; } ;;
    install|home|env|exec) installation_selector "$selector" local || exit $? ;;
    uninstall) installation_selector "$selector" local no-range || exit $? ;;
esac
case "$command" in
    install|home|env|exec)
        if [ -z "$selector" ]; then
            config_setting java || exit 1
            selector=$SETTING
        fi
        if [ -z "$selector" ]; then
            if [ "$command" = install ]; then selector=$DEFAULT_VERSION
            else
                data_path || exit 1
                # An existing reference, including a broken one, must take the
                # normal default path. Only an absent reference permits DEFAULT_VERSION.
                if [ ! -e "$JDKS/default" ] && [ ! -L "$JDKS/default" ]; then selector=$DEFAULT_VERSION; fi
            fi
        fi ;;
esac
[ "$command" != exec ] || execution_umask=$(umask)
resolved_selector=$selector
case "$command" in
    default|home|env|exec)
        if [ -n "$selector" ]; then
            config_policy=
            [ "$command" = default ] || config_policy=config
            ensure_installed "$selector" "$major_option" "$config_policy" || exit $?
            resolved_selector=$INSTALLED_ID
        fi ;;
esac
case "$command" in
    available) available "$selector" ;;
    list) list_installed "$selector" ;;
    install) install_jdk "$selector" "$option" '' config ;;
    uninstall) uninstall_jdk "$selector" ;;
    default) default_jdk "$resolved_selector" "${major_option:-default}" ;;
    home|env) home_environment "$command" "$resolved_selector" "$selector" ;;
    exec) run_jdk "$resolved_selector" "$@" ;;
esac
